    "from datetime import datetime\n",
    "import pytz\n",
    "\n",
    "ts = int(datetime.timestamp(datetime.now()))\n",
    "myDatetime = datetime.fromtimestamp(ts)\n",
    "\n",
    "\n",
    "obj = {\n",
    "        \"updated_at\" : myDatetime\n",
    "    }\n",
    "\n",
    "print(obj)"
